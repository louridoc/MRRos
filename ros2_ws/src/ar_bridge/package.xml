<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ar_bridge</name>
  <version>0.1.0</version>
  <description>Companion node for the MRRos iPhone app: HTTP ingest of scanned point clouds (published as latched PointCloud2 + saved to disk) and mesh serving/conversion for package:// URIs. Supports Humble, Jazzy, Lyrical.</description>
  <maintainer email="44009617+louridoc@users.noreply.github.com">Christian Lourido</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-aiohttp</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <!-- trimesh (DAE/STL→OBJ for /v0/mesh) is optional and pip-installed: `pip install trimesh`. -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
